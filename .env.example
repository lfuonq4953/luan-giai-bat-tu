# Bài luận AI (tuỳ chọn) – điền MỘT trong hai khoá. Có cả hai thì chọn bằng AI_PROVIDER.

# Google Gemini – lấy khoá miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude – https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# gemini | anthropic (bỏ trống: ưu tiên Gemini nếu có khoá)
AI_PROVIDER=
